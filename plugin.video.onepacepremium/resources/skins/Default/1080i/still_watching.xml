<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">11</defaultcontrol>
    <controls>

        <!-- Dimmed background overlay. Nothing is playing behind this one. -->
        <control type="image">
            <left>0</left><top>0</top>
            <width>1920</width><height>1080</height>
            <texture colordiffuse="E60A0C10">../media/white.png</texture>
            <animation type="WindowOpen" reversible="false">
                <effect type="fade" start="0" end="100" time="200" tween="sine" easing="in"/>
            </animation>
            <animation type="WindowClose" reversible="false">
                <effect type="fade" start="100" end="0" time="150" tween="sine" easing="out"/>
            </animation>
        </control>

        <!-- Dialog: 900x400, centred on 1080p -->
        <control type="group">
            <left>510</left><top>340</top>
            <animation type="WindowOpen" reversible="false">
                <effect type="fade" start="0" end="100" time="200" tween="sine" easing="in"/>
                <effect type="zoom" start="95" end="100" time="200" center="auto" tween="quadratic" easing="out"/>
            </animation>
            <animation type="WindowClose" reversible="false">
                <effect type="fade" start="100" end="0" time="150" tween="sine" easing="out"/>
                <effect type="zoom" start="100" end="95" time="150" center="auto" tween="quadratic" easing="out"/>
            </animation>

            <!-- Faux outer border -->
            <control type="image">
                <left>-1</left><top>-1</top>
                <width>902</width><height>402</height>
                <texture colordiffuse="26FFFFFF" border="16">../media/round_dialog.png</texture>
            </control>

            <!-- Dialog background -->
            <control type="image">
                <left>0</left><top>0</top>
                <width>900</width><height>400</height>
                <texture colordiffuse="FF14191E" border="16">../media/round_dialog.png</texture>
            </control>

            <!-- HEADER -->

            <control type="label">
                <left>40</left><top>30</top>
                <width>820</width><height>48</height>
                <font>font14</font>
                <textcolor>FFFFFFFF</textcolor>
                <align>center</align>
                <aligny>center</aligny>
                <label>[B]Still watching?[/B]</label>
            </control>

            <control type="label">
                <left>40</left><top>86</top>
                <width>820</width><height>32</height>
                <font>font12</font>
                <textcolor>FF888899</textcolor>
                <align>center</align>
                <aligny>center</aligny>
                <label>$INFO[Window.Property(pp.episodes)]</label>
            </control>

            <!-- Hairline separator -->
            <control type="image">
                <left>0</left><top>136</top>
                <width>900</width><height>1</height>
                <texture colordiffuse="1AFFFFFF">../media/white.png</texture>
            </control>

            <!-- WHAT WOULD PLAY NEXT -->

            <control type="label">
                <left>40</left><top>160</top>
                <width>820</width><height>34</height>
                <font>font12</font>
                <textcolor>FF888899</textcolor>
                <align>center</align>
                <aligny>center</aligny>
                <label>Up next</label>
            </control>

            <control type="textbox">
                <left>40</left><top>196</top>
                <width>820</width><height>60</height>
                <font>font13</font>
                <textcolor>FFFFFFFF</textcolor>
                <align>center</align>
                <autoscroll>false</autoscroll>
                <label>$INFO[Window.Property(pp.episode)]</label>
            </control>

            <control type="label">
                <left>40</left><top>262</top>
                <width>820</width><height>30</height>
                <font>font12</font>
                <textcolor>FF81A6C6</textcolor>
                <align>center</align>
                <aligny>center</aligny>
                <label>[B]Stopping in $INFO[Window.Property(pp.countdown)]s[/B]</label>
            </control>

            <!-- FOOTER -->

            <control type="button" id="10">
                <left>60</left><top>312</top>
                <width>380</width><height>52</height>
                <onleft>11</onleft><onright>11</onright>
                <onup>11</onup><ondown>11</ondown>
                <label>[B]Stop[/B]</label>
                <font>font13</font>
                <textcolor>FF888899</textcolor>
                <focusedcolor>FF14191E</focusedcolor>
                <texturefocus colordiffuse="FFFFFFFF" border="14">../media/round_btn.png</texturefocus>
                <texturenofocus colordiffuse="18FFFFFF" border="14">../media/round_btn.png</texturenofocus>
                <align>center</align>
                <aligny>center</aligny>
            </control>

            <control type="button" id="11">
                <left>460</left><top>312</top>
                <width>380</width><height>52</height>
                <onleft>10</onleft><onright>10</onright>
                <onup>10</onup><ondown>10</ondown>
                <label>[B]Keep Watching[/B]</label>
                <font>font13</font>
                <textcolor>FF14191E</textcolor>
                <focusedcolor>FF14191E</focusedcolor>
                <texturefocus colordiffuse="FF81A6C6" border="14">../media/round_btn.png</texturefocus>
                <texturenofocus colordiffuse="CC81A6C6" border="14">../media/round_btn.png</texturenofocus>
                <align>center</align>
                <aligny>center</aligny>
            </control>

        </control>
    </controls>
</window>
