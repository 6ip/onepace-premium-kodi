                </control>

                <control type="label">
                    <left>0</left><top>40</top>
                    <width>1120</width><height>30</height>
                    <font>font12</font>
                    <textcolor>FF888899</textcolor>
                    <aligny>center</aligny>
                    <label>$INFO[Window(Home).Property(pp.dl.detail)]</label>
                </control>

                <control type="group">
                    <!-- Nothing under the name: close the gap it would leave. -->
                    <animation effect="slide" start="0,0" end="0,-30" time="0" condition="String.IsEmpty(Window(Home).Property(pp.dl.detail))">Conditional</animation>
                    <control type="image">
                        <left>0</left><top>78</top>
                        <width>1120</width><height>10</height>
                        <texture colordiffuse="14FFFFFF" border="5">../media/round_btn.png</texture>
                </control>
            </control>
                <control type="image">
