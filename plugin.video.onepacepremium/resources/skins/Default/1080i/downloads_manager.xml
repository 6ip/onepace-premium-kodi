            <!-- Hairline above the queue -->
            <control type="image">
                <left>0</left><top>226</top>
                <width>1200</width><height>1</height>
                <texture colordiffuse="1AFFFFFF">../media/white.png</texture>
                <visible>![String.IsEmpty(Window(Home).Property(pp.dl.count)) | String.IsEqual(Window(Home).Property(pp.dl.count),0)]</visible>
            </control>

            <!-- THE QUEUE -->

            <control type="list" id="2500">
                <left>40</left><top>246</top>
                <width>1120</width><height>416</height>
                <onleft>10</onleft><onright>11</onright>
                <onup>2500</onup><ondown>10</ondown>
                <scrolltime tween="sine">200</scrolltime>
                <visible>![String.IsEmpty(Window(Home).Property(pp.dl.count)) | String.IsEqual(Window(Home).Property(pp.dl.count),0)]</visible>

                <itemlayout height="68" width="1120">
                    <control type="image">
                        <left>0</left><top>3</top>
                        <width>1120</width><height>62</height>
                        <texture colordiffuse="0DFFFFFF" border="14">../media/round_btn.png</texture>
                    </control>
                    <control type="label">
                        <left>24</left><top>3</top>
                        <width>820</width><height>34</height>
                        <font>font13</font>
                        <textcolor>FFCCCCCC</textcolor>
                        <aligny>center</aligny>
                        <label>$INFO[ListItem.Property(name)]</label>
                    </control>
                    <control type="label">
                        <left>24</left><top>33</top>
                        <width>820</width><height>30</height>
                        <font>font12</font>
                        <textcolor>FF888899</textcolor>
                        <aligny>center</aligny>
                        <label>$INFO[ListItem.Property(detail)]</label>
                    </control>
                    <control type="label">
                        <left>868</left><top>3</top>
                        <width>228</width><height>62</height>
                        <font>font12</font>
                        <textcolor>FF888899</textcolor>
                        <align>right</align>
                        <aligny>center</aligny>
                        <label>$INFO[ListItem.Property(status)]</label>
                    </control>
                </itemlayout>

                <focusedlayout height="68" width="1120">
                    <control type="image">
                        <left>0</left><top>3</top>
                        <width>1120</width><height>62</height>
                        <texture colordiffuse="26FFFFFF" border="14">../media/round_btn.png</texture>
                        <visible>Control.HasFocus(2500)</visible>
                    </control>
                    <control type="image">
                        <left>0</left><top>3</top>
                        <width>1120</width><height>62</height>
                        <texture colordiffuse="0DFFFFFF" border="14">../media/round_btn.png</texture>
