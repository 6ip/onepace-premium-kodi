<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">2060</defaultcontrol>
    <controls>

        <!-- Dimmed background overlay -->
        <control type="image">
            <left>0</left><top>0</top>
            <width>1920</width><height>1080</height>
            <texture colordiffuse="E60A0C10">../media/white.png</texture>
            <animation type="WindowOpen" reversible="false">
                <effect type="fade" start="0" end="100" time="200" tween="sine" easing="in"/>
            </animation>
            <animation type="WindowClose" reversible="false">
                <effect type="fade" start="100" end="0" time="150" tween="sine" easing="out"/>
            </animation>
        </control>

        <!-- Dialog: 1200x760, centred on 1080p -->
        <control type="group">
            <left>360</left><top>160</top>
            <animation type="WindowOpen" reversible="false">
                <effect type="fade" start="0" end="100" time="200" tween="sine" easing="in"/>
                <effect type="zoom" start="95" end="100" time="200" center="auto" tween="quadratic" easing="out"/>
            </animation>
            <animation type="WindowClose" reversible="false">
                <effect type="fade" start="100" end="0" time="150" tween="sine" easing="out"/>
                <effect type="zoom" start="100" end="95" time="150" center="auto" tween="quadratic" easing="out"/>
            </animation>

            <!-- Faux outer border -->
            <control type="image">
                <left>-1</left><top>-1</top>
                <width>1202</width><height>762</height>
                <texture colordiffuse="26FFFFFF" border="16">../media/round_dialog.png</texture>
            </control>

            <!-- Dialog background -->
            <control type="image">
                <left>0</left><top>0</top>
                <width>1200</width><height>760</height>
                <texture colordiffuse="FF14191E" border="16">../media/round_dialog.png</texture>
            </control>

            <!-- ── HEADER ── -->

            <control type="image">
                <left>30</left><top>17</top>
                <width>44</width><height>44</height>
                <aspectratio>keep</aspectratio>
                <texture>$INFO[Window.Property(pp.icon)]</texture>
            </control>

            <control type="label">
                <left>86</left><top>17</top>
                <width>700</width><height>44</height>
                <font>font14</font>
                <textcolor>FFFFFFFF</textcolor>
                <align>left</align>
                <aligny>center</aligny>
                <label>[B]What's New[/B]</label>
            </control>

            <!-- Version pill, right aligned -->
            <control type="label">
                <left>870</left><top>17</top>
                <width>300</width><height>44</height>
                <font>font13</font>
                <textcolor>FF81A6C6</textcolor>
                <align>right</align>
                <aligny>center</aligny>
                <label>[B]$INFO[Window.Property(pp.version)][/B]</label>
            </control>

            <!-- Hairline separator -->
            <control type="image">
                <left>0</left><top>78</top>
                <width>1200</width><height>1</height>
                <texture colordiffuse="1AFFFFFF">../media/white.png</texture>
            </control>

            <!-- ── BODY ── -->

            <!-- pagecontrol binds this to the scrollbar, or nothing scrolls -->
            <control type="textbox" id="2000">
                <left>40</left><top>102</top>
                <width>1080</width><height>556</height>
                <font>font13</font>
                <textcolor>FFCCCCCC</textcolor>
                <align>left</align>
                <autoscroll>false</autoscroll>
                <scrolltime tween="sine">300</scrolltime>
                <label>$INFO[Window.Property(pp.text)]</label>
                <pagecontrol>2060</pagecontrol>
            </control>

            <control type="scrollbar" id="2060">
                <left>1140</left><top>102</top>
                <width>18</width><height>556</height>
                <texturesliderbackground colordiffuse="14FFFFFF" border="8">../media/round_btn.png</texturesliderbackground>
                <texturesliderbar colordiffuse="40FFFFFF" border="8">../media/round_btn.png</texturesliderbar>
                <texturesliderbarfocus colordiffuse="FF81A6C6" border="8">../media/round_btn.png</texturesliderbarfocus>
                <textureslidernib>-</textureslidernib>
                <textureslidernibfocus>-</textureslidernibfocus>
                <onleft>2060</onleft><onright>11</onright>
                <onup>2060</onup><ondown>2060</ondown>
                <showonepage>false</showonepage>
                <orientation>vertical</orientation>
            </control>

            <!-- Hairline above the footer -->
            <control type="image">
                <left>0</left><top>680</top>
                <width>1200</width><height>1</height>
                <texture colordiffuse="1AFFFFFF">../media/white.png</texture>
            </control>

            <!-- ── FOOTER ── -->

            <control type="button" id="11">
                <left>640</left><top>698</top>
                <width>256</width><height>48</height>
                <onleft>2060</onleft><onright>10</onright>
                <onup>2060</onup><ondown>2060</ondown>
                <label>[B]Donate[/B]</label>
                <font>font13</font>
                <textcolor>FF888899</textcolor>
                <focusedcolor>FF14191E</focusedcolor>
                <texturefocus colordiffuse="FFFFFFFF" border="14">../media/round_btn.png</texturefocus>
                <texturenofocus colordiffuse="18FFFFFF" border="14">../media/round_btn.png</texturenofocus>
                <align>center</align>
                <aligny>center</aligny>
            </control>

            <control type="button" id="10">
                <left>914</left><top>698</top>
                <width>256</width><height>48</height>
                <onleft>11</onleft><onright>2060</onright>
                <onup>2060</onup><ondown>2060</ondown>
                <label>[B]Close[/B]</label>
                <font>font13</font>
                <textcolor>FF14191E</textcolor>
                <focusedcolor>FF14191E</focusedcolor>
                <texturefocus colordiffuse="FF81A6C6" border="14">../media/round_btn.png</texturefocus>
                <texturenofocus colordiffuse="CC81A6C6" border="14">../media/round_btn.png</texturenofocus>
                <align>center</align>
                <aligny>center</aligny>
            </control>

        </control>
    </controls>
</window>
