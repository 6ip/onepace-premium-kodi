<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">11</defaultcontrol>
    <controls>

        <!-- Card: 760x250, bottom-right. No dimmed backdrop; the episode is still playing. -->
        <control type="group">
            <left>1140</left><top>730</top>
            <animation type="WindowOpen" reversible="false">
                <effect type="fade" start="0" end="100" time="200" tween="sine" easing="in"/>
                <effect type="slide" start="60,0" end="0,0" time="250" tween="quadratic" easing="out"/>
            </animation>
            <animation type="WindowClose" reversible="false">
                <effect type="fade" start="100" end="0" time="150" tween="sine" easing="out"/>
                <effect type="slide" start="0,0" end="60,0" time="150" tween="quadratic" easing="in"/>
            </animation>

            <!-- Faux outer border -->
            <control type="image">
                <left>-1</left><top>-1</top>
                <width>722</width><height>252</height>
                <texture colordiffuse="26FFFFFF" border="16">../media/round_dialog.png</texture>
            </control>

            <!-- Card background -->
            <control type="image">
                <left>0</left><top>0</top>
                <width>720</width><height>250</height>
                <texture colordiffuse="FF14191E" border="16">../media/round_dialog.png</texture>
            </control>

            <!-- Episode thumbnail, flush to the left edge -->
            <control type="image" id="200">
                <left>0</left><top>0</top>
                <width>250</width><height>250</height>
                <aspectratio scalediffuse="false">scale</aspectratio>
                <texture border="16">../media/white.png</texture>
            </control>

            <!-- "Next on <series>" — one label so the spacing is not positional -->
            <control type="label" id="201">
                <left>282</left><top>26</top>
                <width>408</width><height>30</height>
                <font>font12</font>
                <textcolor>FFFFFFFF</textcolor>
                <label>$INFO[Window.Property(pp.series)]</label>
            </control>

            <!-- Episode title: a textbox so long names wrap instead of truncating -->
            <control type="textbox" id="202">
                <left>282</left><top>68</top>
                <width>408</width><height>76</height>
                <font>font12</font>
                <textcolor>FFFFFFFF</textcolor>
                <autoscroll>false</autoscroll>
                <label>$INFO[Window.Property(pp.episode)]</label>
            </control>

            <!-- Dismiss. The button carries only the focus texture; the icon and
                 text are separate controls, because a Kodi button reserves
                 textoffsetx on BOTH sides and would truncate the label. -->
            <control type="button" id="10">
                <left>301</left><top>174</top>
                <width>157</width><height>44</height>
                <label></label>
                <texturefocus colordiffuse="1AFFFFFF" border="14">../media/round_btn.png</texturefocus>
                <texturenofocus />
                <onleft>11</onleft><onright>11</onright>
                <onup>11</onup><ondown>11</ondown>
            </control>
            <control type="image">
                <left>319</left><top>186</top>
                <width>20</width><height>20</height>
                <texture colordiffuse="FF888899">../media/icon_close.png</texture>
            </control>
            <control type="label">
                <left>351</left><top>174</top>
                <width>107</width><height>44</height>
                <font>font12</font>
                <textcolor>FF888899</textcolor>
                <align>left</align>
                <aligny>center</aligny>
                <label>Dismiss</label>
                <visible>!Control.HasFocus(10)</visible>
            </control>
            <control type="label">
                <left>351</left><top>174</top>
                <width>107</width><height>44</height>
                <font>font12</font>
                <textcolor>FFFFFFFF</textcolor>
                <align>left</align>
                <aligny>center</aligny>
                <label>Dismiss</label>
                <visible>Control.HasFocus(10)</visible>
            </control>

            <!-- Watch now -->
            <control type="button" id="11">
                <left>472</left><top>174</top>
                <width>198</width><height>44</height>
                <label></label>
                <texturefocus colordiffuse="FF81A6C6" border="14">../media/round_btn.png</texturefocus>
                <texturenofocus colordiffuse="CC81A6C6" border="14">../media/round_btn.png</texturenofocus>
                <onleft>10</onleft><onright>10</onright>
                <onup>10</onup><ondown>10</ondown>
            </control>
            <control type="image">
                <left>490</left><top>186</top>
                <width>20</width><height>20</height>
                <texture colordiffuse="FF14191E">../media/icon_play.png</texture>
            </control>
            <control type="label">
                <left>522</left><top>174</top>
                <width>148</width><height>44</height>
                <font>font12</font>
                <textcolor>FF14191E</textcolor>
                <align>left</align>
                <aligny>center</aligny>
                <label>Watch now</label>
            </control>

            <!-- How much of the current episode is left. Nothing happens when it
                 empties; the episode simply ends and the card closes. -->
            <control type="progress" id="300">
                <left>282</left><top>232</top>
                <width>408</width><height>4</height>
                <texturebg colordiffuse="26FFFFFF" border="0">../media/white.png</texturebg>
                <lefttexture>-</lefttexture>
                <midtexture colordiffuse="FF81A6C6">../media/white.png</midtexture>
                <righttexture>-</righttexture>
                <overlaytexture>-</overlaytexture>
            </control>

        </control>
    </controls>
</window>
