<?xml version="1.0" encoding="UTF-8"?>
<window>
    <!-- Modeless, so Kodi keeps sending the remote to the player underneath
         instead of to this. No defaultcontrol and nothing focusable either:
         there is nothing here to operate. -->
    <modality>modeless</modality>
    <controls>

        <!-- Bar: 540x150, bottom-right. No dimmed backdrop; the episode is still playing. -->
        <control type="group">
            <left>1320</left><top>830</top>
            <animation type="WindowOpen" reversible="false">
                <effect type="fade" start="0" end="100" time="200" tween="sine" easing="in"/>
                <effect type="slide" start="60,0" end="0,0" time="250" tween="quadratic" easing="out"/>
            </animation>
            <animation type="WindowClose" reversible="false">
                <effect type="fade" start="100" end="0" time="150" tween="sine" easing="out"/>
                <effect type="slide" start="0,0" end="60,0" time="150" tween="quadratic" easing="in"/>
            </animation>
            <!-- The player's own controls sit exactly where this does, so step
                 up above them. How far is a setting: every skin puts them at a
                 different height and Kodi offers no way to ask where they are.
                 A move and nothing else, because fading a group fades every
                 control in it separately and the layers show through. -->
            <animation effect="slide" start="0,0" end="0,-20" time="200" tween="quadratic" easing="out" condition="[Window.IsVisible(videoosd) | Window.IsVisible(fullscreeninfo) | Player.Seeking | Player.ShowInfo | Player.ShowTime | Player.Forwarding | Player.Rewinding] + String.IsEqual(Window(Home).Property(pp.lift),20)">Conditional</animation>
            <animation effect="slide" start="0,0" end="0,-40" time="200" tween="quadratic" easing="out" condition="[Window.IsVisible(videoosd) | Window.IsVisible(fullscreeninfo) | Player.Seeking | Player.ShowInfo | Player.ShowTime | Player.Forwarding | Player.Rewinding] + String.IsEqual(Window(Home).Property(pp.lift),40)">Conditional</animation>
            <animation effect="slide" start="0,0" end="0,-60" time="200" tween="quadratic" easing="out" condition="[Window.IsVisible(videoosd) | Window.IsVisible(fullscreeninfo) | Player.Seeking | Player.ShowInfo | Player.ShowTime | Player.Forwarding | Player.Rewinding] + String.IsEqual(Window(Home).Property(pp.lift),60)">Conditional</animation>
            <animation effect="slide" start="0,0" end="0,-80" time="200" tween="quadratic" easing="out" condition="[Window.IsVisible(videoosd) | Window.IsVisible(fullscreeninfo) | Player.Seeking | Player.ShowInfo | Player.ShowTime | Player.Forwarding | Player.Rewinding] + String.IsEqual(Window(Home).Property(pp.lift),80)">Conditional</animation>
            <animation effect="slide" start="0,0" end="0,-100" time="200" tween="quadratic" easing="out" condition="[Window.IsVisible(videoosd) | Window.IsVisible(fullscreeninfo) | Player.Seeking | Player.ShowInfo | Player.ShowTime | Player.Forwarding | Player.Rewinding] + String.IsEqual(Window(Home).Property(pp.lift),100)">Conditional</animation>
            <animation effect="slide" start="0,0" end="0,-120" time="200" tween="quadratic" easing="out" condition="[Window.IsVisible(videoosd) | Window.IsVisible(fullscreeninfo) | Player.Seeking | Player.ShowInfo | Player.ShowTime | Player.Forwarding | Player.Rewinding] + String.IsEqual(Window(Home).Property(pp.lift),120)">Conditional</animation>
            <animation effect="slide" start="0,0" end="0,-140" time="200" tween="quadratic" easing="out" condition="[Window.IsVisible(videoosd) | Window.IsVisible(fullscreeninfo) | Player.Seeking | Player.ShowInfo | Player.ShowTime | Player.Forwarding | Player.Rewinding] + String.IsEqual(Window(Home).Property(pp.lift),140)">Conditional</animation>
            <animation effect="slide" start="0,0" end="0,-160" time="200" tween="quadratic" easing="out" condition="[Window.IsVisible(videoosd) | Window.IsVisible(fullscreeninfo) | Player.Seeking | Player.ShowInfo | Player.ShowTime | Player.Forwarding | Player.Rewinding] + String.IsEqual(Window(Home).Property(pp.lift),160)">Conditional</animation>
            <animation effect="slide" start="0,0" end="0,-180" time="200" tween="quadratic" easing="out" condition="[Window.IsVisible(videoosd) | Window.IsVisible(fullscreeninfo) | Player.Seeking | Player.ShowInfo | Player.ShowTime | Player.Forwarding | Player.Rewinding] + String.IsEqual(Window(Home).Property(pp.lift),180)">Conditional</animation>
            <animation effect="slide" start="0,0" end="0,-200" time="200" tween="quadratic" easing="out" condition="[Window.IsVisible(videoosd) | Window.IsVisible(fullscreeninfo) | Player.Seeking | Player.ShowInfo | Player.ShowTime | Player.Forwarding | Player.Rewinding] + String.IsEqual(Window(Home).Property(pp.lift),200)">Conditional</animation>
            <animation effect="slide" start="0,0" end="0,-220" time="200" tween="quadratic" easing="out" condition="[Window.IsVisible(videoosd) | Window.IsVisible(fullscreeninfo) | Player.Seeking | Player.ShowInfo | Player.ShowTime | Player.Forwarding | Player.Rewinding] + String.IsEqual(Window(Home).Property(pp.lift),220)">Conditional</animation>
            <animation effect="slide" start="0,0" end="0,-240" time="200" tween="quadratic" easing="out" condition="[Window.IsVisible(videoosd) | Window.IsVisible(fullscreeninfo) | Player.Seeking | Player.ShowInfo | Player.ShowTime | Player.Forwarding | Player.Rewinding] + String.IsEqual(Window(Home).Property(pp.lift),240)">Conditional</animation>

            <!-- Faux outer border -->
            <control type="image">
                <left>-1</left><top>-1</top>
                <width>542</width><height>152</height>
                <texture colordiffuse="26FFFFFF" border="16">../media/round_dialog.png</texture>
            </control>

            <!-- Bar background -->
            <control type="image">
                <left>0</left><top>0</top>
                <width>540</width><height>150</height>
                <texture colordiffuse="FF14191E" border="16">../media/round_dialog.png</texture>
            </control>

            <!-- Episode thumbnail, flush to the left edge -->
            <control type="image" id="200">
                <left>0</left><top>0</top>
                <width>150</width><height>150</height>
                <aspectratio scalediffuse="false">scale</aspectratio>
                <texture border="16">../media/white.png</texture>
            </control>

            <!-- "Next on <series>" — one label so the spacing is not positional -->
            <control type="label" id="201">
                <left>168</left><top>16</top>
                <width>240</width><height>26</height>
                <font>font12</font>
                <textcolor>FFFFFFFF</textcolor>
                <label>$INFO[Window.Property(pp.series)]</label>
            </control>

            <!-- Seconds left, so it reads as a countdown and not a question -->
            <control type="label">
                <left>410</left><top>16</top>
                <width>112</width><height>26</height>
                <font>font12</font>
                <textcolor>FF81A6C6</textcolor>
                <align>right</align>
                <aligny>center</aligny>
                <label>[B]$INFO[Window.Property(pp.countdown)][/B]</label>
            </control>

            <!-- Episode title: a textbox so long names wrap instead of truncating -->
            <control type="textbox" id="202">
                <left>168</left><top>48</top>
                <width>354</width><height>76</height>
                <font>font12</font>
                <textcolor>FFFFFFFF</textcolor>
                <autoscroll>false</autoscroll>
                <label>$INFO[Window.Property(pp.episode)]</label>
            </control>

            <!-- How much of the current episode is left -->
            <control type="progress" id="300">
                <left>168</left><top>130</top>
                <width>354</width><height>4</height>
                <texturebg colordiffuse="26FFFFFF" border="0">../media/white.png</texturebg>
                <lefttexture>-</lefttexture>
                <midtexture colordiffuse="FF81A6C6">../media/white.png</midtexture>
                <righttexture>-</righttexture>
                <overlaytexture>-</overlaytexture>
            </control>

        </control>
    </controls>
</window>
